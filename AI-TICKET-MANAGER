def clean_text(text):

    text = str(text).lower()

    # Remove template placeholders such as:
    # {product_purchased}
    # {error_message}
    text = re.sub(r"\{[^}]*\}", " ", text)

    # Keep letters, numbers and spaces
    text = re.sub(r"[^a-z0-9\s]", " ", text)

    # Remove extra spaces
    text = re.sub(r"\s+", " ", text).strip()

    return text


