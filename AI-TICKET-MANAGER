# 32. MACHINE LEARNING FEASIBILITY
# ============================================================

print("\n" + "=" * 70)
print("MACHINE LEARNING FEASIBILITY")
print("=" * 70)

print(
    "The following model uses only text features."
)

print(
    "Ticket Type and Ticket Priority are excluded because "
    "they duplicate the target variables."
)


# Use clean text only
X = df["clean_text"].fillna("")

y_category = df["category"]

# Combined stratification
stratify_label = (
    y_category.astype(str)
    + "_"
    + df["urgency"].astype(str)
)


X_train, X_test, y_train, y_test = train_test_split(
    X,
    y_category,
    test_size=0.20,
    random_state=42,
    stratify=stratify_label
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))


# ============================================================
# 33. TF-IDF
# ============================================================

print("\n" + "=" * 70)
print("TF-IDF FEATURE EXTRACTION")
print("=" * 70)

tfidf = TfidfVectorizer(
    max_features=10000,
    ngram_range=(1, 2),
    min_df=2,
    max_df=0.95,
    sublinear_tf=True
)

X_train_tfidf = tfidf.fit_transform(X_train)
X_test_tfidf = tfidf.transform(X_test)

print("Training TF-IDF shape:",
      X_train_tfidf.shape)

print("Testing TF-IDF shape:",
      X_test_tfidf.shape)

print("Vocabulary size:",
      len(tfidf.vocabulary_))


# ============================================================
# 34. LOGISTIC REGRESSION
# ============================================================

print("\n" + "=" * 70)
print("CATEGORY CLASSIFICATION")
print("=" * 70)

category_model = LogisticRegression(
    max_iter=1000,
    random_state=42
)

category_model.fit(
    X_train_tfidf,
    y_train
)

category_pred = category_model.predict(
    X_test_tfidf
)

category_accuracy = accuracy_score(
    y_test,
    category_pred
)

print(
    f"Logistic Regression Accuracy: "
    f"{category_accuracy * 100:.2f}%"
)

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        category_pred,
        zero_division=0
    )
)


